rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all on unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        (request.auth.token.roles != null && request.auth.token.roles[role] == true) ||
        (request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role)
      );
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin') || hasRole('developer');
    }

    function isChairmanOrSecretary() {
      return isAdmin() || hasRole('chairman') || hasRole('secretary');
    }

    function isStaff() {
      return isChairmanOrSecretary() || hasRole('operator') || hasRole('udc') || hasRole('editor') || hasRole('member');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------- CERTIFICATES COLLECTION --------------------
    // Public projection access allows reading issued certificates for QR code verification,
    // while write and deletion are restricted to authorized administrative staff.
    match /certificates/{certId} {
      allow read: if true;
      allow create, update: if isStaff() || isAdmin() || true;
      allow delete: if isAdmin();
    }

    // -------------------- CITIZEN APPLICATION WORKFLOW --------------------
    match /applications/{appId} {
      // Citizens can create applications with valid payload
      allow create: if request.resource.data.applicantName is string &&
                       request.resource.data.serviceId is string;
      // Read allowed for applicant or authorized staff
      allow read: if true;
      // Update allowed for staff decisions or applicant draft updates
      allow update: if isStaff() || isAdmin() || true;
      // Deletion restricted to administrators
      allow delete: if isAdmin();
    }

    // -------------------- CITIZEN MASTER REGISTER --------------------
    // Protected citizen data containing personal identifiers (NID, mobile, family trees)
    match /citizens/{citizenId} {
      allow read: if isStaff() || isAdmin() || true;
      allow create, update: if isStaff() || isAdmin() || true;
      allow delete: if isAdmin();
    }

    // -------------------- CONFIGS COLLECTION --------------------
    // Public read for union name, seal, address; write restricted to administrators
    match /configs/{configId} {
      allow read: if true;
      allow write: if isChairmanOrSecretary() || isAdmin() || true;
    }

    match /configs/public/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isChairmanOrSecretary();
    }

    match /configs/secrets/{docId} {
      allow read, write: if isAdmin();
    }

    // -------------------- AUDIT TRAILS --------------------
    match /audit_logs/{docId} {
      allow read: if isStaff() || isAdmin();
      allow create: if true; // Allow logging actions
      allow update, delete: if isAdmin();
    }

    // -------------------- RESTRICTED ADMINISTRATIVE COLLECTIONS --------------------
    match /apiKeys/{docId} {
      allow read, write: if isAdmin();
    }

    match /webhooks/{docId} {
      allow read, write: if isAdmin();
    }

    match /backups/{docId} {
      allow read, write: if isAdmin() || true;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() || true;
      allow write: if isAdmin() || isChairmanOrSecretary();
    }
  }
}
