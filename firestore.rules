rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  // Only Firebase Auth custom claims are authoritative. Never read roles from user documents.
  function role(){return signedIn() ? request.auth.token.get('role','') : '';}
  function admin(){return role() in ['admin','developer'];}
  function approver(){return role() in ['admin','developer','chairman','secretary'];}
  function staff(){return role() in ['admin','developer','chairman','secretary','operator','udc'];}
  function validText(v,max){return v is string && v.size() <= max;}
  function approvedService(id){
   return exists(/databases/$(database)/documents/approvedApplicationServices/$(id))
    && get(/databases/$(database)/documents/approvedApplicationServices/$(id)).data.enabled == true
    && get(/databases/$(database)/documents/approvedApplicationServices/$(id)).data.formVerified == true;
  }
  // Explicit public projection. A trusted backend must write it only after final issuance.
  // Never include names, NID, birth registration numbers, phone numbers, or addresses.
  match /publicCertificateVerifications/{verificationId} {
   allow get: if true;
   allow list, create, update, delete: if false;
  }
  match /citizenProfilesV2/{profileId} {
   allow get, list: if staff();
   allow create: if staff()
    && request.resource.data.keys().hasOnly(['id','name','father','mother','gender','nid','birthNo','mobile','spouseName','village','wardNo','postOffice','postCode','holdingNo','dateOfBirth','nameEn','occupation','permanentAddress','currentAddress','education','emergencyContact','createdAt','updatedAt','createdBy'])
    && request.resource.data.id == profileId
    && request.resource.data.createdBy == request.auth.uid
    && validText(request.resource.data.name,200)
    && request.resource.data.name.size() > 0;
   allow update, delete: if false;
  }
  match /approvedApplicationServices/{serviceId} {
   allow get, list: if staff();
   allow create, update, delete: if false;
  }
  match /citizenApplicationsV1/{applicationId} {
   allow get, list: if staff() && resource.data.ownerUid == request.auth.uid;
   allow create: if staff()
    && request.resource.data.keys().hasOnly(['id','serviceId','citizenId','ownerUid','status','schemaVersion','fieldValues','createdAt','updatedAt'])
    && request.resource.data.id == applicationId
    && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.status == 'draft'
    && validText(request.resource.data.serviceId,128)
    && approvedService(request.resource.data.serviceId)
    && exists(/databases/$(database)/documents/citizenProfilesV2/$(request.resource.data.citizenId))
    && request.resource.data.fieldValues is map
    && request.resource.data.fieldValues.keys().hasOnly(['reason'])
    && validText(request.resource.data.fieldValues.reason,1500);
   allow update: if staff()
    && resource.data.ownerUid == request.auth.uid
    && resource.data.status == 'draft'
    && request.resource.data.id == resource.data.id
    && request.resource.data.ownerUid == resource.data.ownerUid
    && request.resource.data.serviceId == resource.data.serviceId
    && request.resource.data.citizenId == resource.data.citizenId
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.schemaVersion == resource.data.schemaVersion
    && approvedService(resource.data.serviceId)
    && (
     (request.resource.data.status == 'draft'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fieldValues','updatedAt'])
      && request.resource.data.fieldValues is map
      && request.resource.data.fieldValues.keys().hasOnly(['reason'])
      && validText(request.resource.data.fieldValues.reason,1500))
     ||
     (request.resource.data.status == 'submitted'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','submittedAt'])
      && validText(request.resource.data.submittedAt,40))
    );
   allow delete: if false;
  }
  // Legacy certificate records contain PII. Restrict read to staff and writes to admin only.
  // Issuance and public verification should migrate to a trusted server.
  match /certificates/{certId} {
   allow get, list: if staff();
   allow create, update, delete: if admin();
  }
  match /citizens/{citizenId} {
   allow get, list: if staff();
   allow create, update: if staff();
   allow delete: if admin();
  }
  match /configs/{configId} {
   allow get, list: if staff();
   allow create, update, delete: if admin();
  }
  match /configs/public/{docId} {
   allow get, list: if true;
   allow create, update, delete: if admin();
  }
  match /configs/secrets/{docId} {
   allow get, list, create, update, delete: if false;
  }
  match /apiKeys/{docId} {
   allow get, list, create, update, delete: if false;
  }
  match /webhooks/{docId} {
   allow get, list, create, update, delete: if false;
  }
  match /backups/{docId} {
   allow get, list, create, update, delete: if false;
  }
  match /{document=**} {
   allow read, write: if false;
  }
 }
}
